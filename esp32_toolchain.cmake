include(CMakeForceCompiler)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv)
set(FLAGS "-ffunction-sections -fdata-sections -msoft-float" CACHE STRING "" FORCE)
set(CMAKE_CROSSCOMPILING 1)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
if(DEFINED ENV{PLATFORMIO_PACKAGES_DIR})
    set(PLATFORMIO_PACKAGES "$ENV{PLATFORMIO_PACKAGES_DIR}")
else()
    set(PLATFORMIO_PACKAGES "$ENV{HOME}/.platformio/packages")
endif()
set(CMAKE_C_COMPILER "${PLATFORMIO_PACKAGES}/toolchain-riscv32-esp/bin/riscv32-esp-elf-gcc")
set(CMAKE_CXX_COMPILER "${PLATFORMIO_PACKAGES}/toolchain-riscv32-esp/bin/riscv32-esp-elf-g++")
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${FLAGS} ${IDF_INCLUDES}" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fno-exceptions -fno-rtti ${FLAGS} ${IDF_INCLUDES}" CACHE STRING "" FORCE)
add_compile_definitions(ESP_PLATFORM LWIP_IPV4 LWIP_IPV6 PLATFORM_NAME_FREERTOS)
